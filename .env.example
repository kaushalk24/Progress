# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> Data API  (URL)
#   Supabase dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# Both values are PUBLIC and end up in the built JavaScript bundle. That is by
# design: the anon key only grants what Row Level Security allows. Never put the
# service_role key here -- it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
